# ==========================================
# LITTERA - SUPABASE EDGE FUNCTIONS ENV VARS
# ==========================================

# Supabase Core (inseridas automaticamente em produção pelo Supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh..."
SUPABASE_ANON_KEY="eyJh..."

# Site / Aplicação Frontend (usado para links de redirecionamento e convites)
SITE_URL="https://app.littera.com.br"
APP_URL="https://app.littera.com.br"

# ==========================================
# BREVO - NOTIFICAÇÕES TRANSACIONAIS E E-MAILS
# ==========================================
# Chave de API V3 gerada em https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx"

# E-mail remetente autenticado / verificado na conta Brevo
BREVO_SENDER_EMAIL="contato@littera.com.br"

# Nome do remetente exibido na caixa de entrada dos destinatários
BREVO_SENDER_NAME="Littera - Inteligência em Redação"

# Opcional: ID de template padrão no Brevo para convites de usuários
# BREVO_INVITE_TEMPLATE_ID="1"

# ==========================================
# OUTRAS INTEGRAÇÕES (ASAAS, ETC.)
# ==========================================
ASAAS_API_KEY="$aact_prod_..."
ASAAS_ENV="production"
ASAAS_WEBHOOK_TOKEN="your_webhook_token"
ASAAS_WEBHOOK_SECRET="your_webhook_secret"
